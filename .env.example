# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cmmc_genie?schema=public"

# NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"
# NextAuth v5 uses AUTH_SECRET (keeping NEXTAUTH_SECRET for backward compatibility)
AUTH_SECRET="your-secret-key-here-generate-with-openssl-rand-base64-32"

# OAuth Providers
# Microsoft Entra ID (Azure AD)
AZURE_AD_CLIENT_ID="your-microsoft-client-id"
AZURE_AD_CLIENT_SECRET="your-microsoft-client-secret"
AZURE_AD_TENANT_ID="common"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Zoom OAuth
ZOOM_CLIENT_ID="your-zoom-client-id"
ZOOM_CLIENT_SECRET="your-zoom-client-secret"

# AI APIs
# OpenAI API (Primary)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_ORG_ID="" # Optional - only needed for organization accounts
OPENAI_MODEL="gpt-4o" # Options: gpt-4o, gpt-4-turbo, gpt-4, gpt-3.5-turbo

# Anthropic Claude API (Optional - for future provider switching)
ANTHROPIC_API_KEY="" # Optional
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022" # Optional

# AI Provider Selection
AI_PROVIDER="openai" # Options: openai, anthropic

# External Services
# Email Service (SendGrid or Resend)
SENDGRID_API_KEY="your-sendgrid-api-key"
RESEND_API_KEY="your-resend-api-key"

# File Storage (AWS S3 or Cloudflare R2)
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="cmmc-genie-uploads"

# Or Cloudflare R2
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_ACCESS_KEY_ID="your-r2-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-r2-secret-key"
R2_BUCKET_NAME="cmmc-genie-uploads"

# Transcription Services
AZURE_SPEECH_KEY="your-azure-speech-key"
AZURE_SPEECH_REGION="eastus"
ASSEMBLYAI_API_KEY="your-assemblyai-key"

# Calendar Integrations
# Microsoft Graph API (reuses Azure AD credentials)
MICROSOFT_GRAPH_CLIENT_ID="${AZURE_AD_CLIENT_ID}"
MICROSOFT_GRAPH_CLIENT_SECRET="${AZURE_AD_CLIENT_SECRET}"

# Google Calendar API
GOOGLE_CALENDAR_CLIENT_ID="${GOOGLE_CLIENT_ID}"
GOOGLE_CALENDAR_CLIENT_SECRET="${GOOGLE_CLIENT_SECRET}"

# Vector Database (Pinecone)
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-east-1-aws"
PINECONE_INDEX_NAME="cmmc-genie"

# Monitoring & Analytics
SENTRY_DSN="your-sentry-dsn"
NEXT_PUBLIC_SENTRY_DSN="${SENTRY_DSN}"

# Feature Flags
NEXT_PUBLIC_ENABLE_AI_AGENTS="true"
NEXT_PUBLIC_ENABLE_CALENDAR_INTEGRATION="true"
NEXT_PUBLIC_ENABLE_TRANSCRIPTION="true"

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
